{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_APP_ENV": "development",
        "EXPO_PUBLIC_API_URL": "https://nexus-ai-v1.onrender.com"
      },
      "channel": "preview",
      "node": "22.14.0",
      "pnpm": "10.0.0"
    },
    "preview": {
      "distribution": "internal",
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_APP_ENV": "preview",
        "EXPO_PUBLIC_API_URL": "https://nexus-ai-v1.onrender.com"
      },
      "channel": "preview",
      "node": "22.14.0",
      "pnpm": "10.0.0"
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_APP_ENV": "production",
        "EXPO_PUBLIC_API_URL": "https://nexus-ai-v1.onrender.com"
      },
      "channel": "production",
      "node": "22.14.0",
      "pnpm": "10.0.0"
    },
    "release": {
      "distribution": "internal",
      "autoIncrement": true,
      "channel": "production",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_APP_ENV": "production",
        "EXPO_PUBLIC_API_URL": "https://nexus-ai-v1.onrender.com"
      },
      "node": "22.14.0",
      "pnpm": "10.0.0"
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal"
      }
    }
  }
}
