<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/nexus_widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:minWidth="250dp" android:minHeight="110dp" android:paddingLeft="12dp" android:paddingRight="12dp" android:paddingTop="8dp" android:paddingBottom="8dp" android:background="@drawable/nexus_widget_background">
  <ImageView android:id="@+id/nexus_widget_scene" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:alpha="0.85" android:visibility="gone" android:importantForAccessibility="no"/>
  <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
      <FrameLayout android:id="@+id/nexus_widget_mascot_stage" android:layout_width="28dp" android:layout_height="28dp" android:gravity="center">
        <ImageView android:id="@+id/nexus_widget_mascot" android:layout_width="28dp" android:layout_height="28dp" android:layout_gravity="center" android:adjustViewBounds="true" android:scaleType="fitCenter" android:src="@drawable/ic_nexus_mascot" android:contentDescription="@string/nexus_widget_mascot_description"/>
      </FrameLayout>
      <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:orientation="vertical">
        <TextView android:id="@+id/nexus_widget_brand" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Missão de hoje" android:textColor="#C9C0FF" android:textSize="8sp" android:letterSpacing="0.08" android:textAllCaps="true" android:textStyle="bold" android:maxLines="1" android:ellipsize="end"/>
        <TextView android:id="@+id/nexus_widget_mission" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Entregar o primeiro ciclo" android:textColor="#EDEFF4" android:textSize="12sp" android:maxLines="2" android:ellipsize="end" android:textStyle="bold" android:layout_marginTop="2dp"/>
      </LinearLayout>
      <TextView android:id="@+id/nexus_widget_focus_button" android:layout_width="wrap_content" android:layout_height="24dp" android:minWidth="56dp" android:paddingLeft="10dp" android:paddingRight="10dp" android:gravity="center" android:text="▶ Focar" android:textColor="#120E26" android:textSize="10sp" android:textStyle="bold" android:maxLines="1" android:background="@drawable/nexus_widget_pill" android:layout_marginStart="6dp"/>
    </LinearLayout>
    <ProgressBar android:id="@+id/nexus_widget_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="4dp" android:progressDrawable="@drawable/nexus_widget_progress" android:max="100" android:progress="40" android:layout_marginTop="6dp" android:layout_marginBottom="2dp"/>
    <LinearLayout android:id="@+id/nexus_widget_task_1" style="@style/NexusWidgetTaskRow">
      <TextView android:id="@+id/nexus_widget_check_1" style="@style/NexusWidgetCheck"/>
      <TextView android:id="@+id/nexus_widget_task_title_1" style="@style/NexusWidgetTaskTitle" android:text="Validar retomada"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/nexus_widget_task_2" style="@style/NexusWidgetTaskRow">
      <TextView android:id="@+id/nexus_widget_check_2" style="@style/NexusWidgetCheck"/>
      <TextView android:id="@+id/nexus_widget_task_title_2" style="@style/NexusWidgetTaskTitle" android:text="Salvar evidência"/>
    </LinearLayout>
  </LinearLayout>
  <LinearLayout android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" android:orientation="vertical">
    <TextView android:id="@+id/nexus_widget_feature_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textColor="#EDEFF4" android:textSize="11sp" android:maxLines="2" android:ellipsize="end" />
    <TextView android:id="@+id/nexus_widget_feature_body" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textColor="#EDEFF4" android:textSize="11sp" android:maxLines="2" android:ellipsize="end" />
    <TextView android:id="@+id/nexus_widget_metrics" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textColor="#EDEFF4" android:textSize="11sp" android:maxLines="2" android:ellipsize="end" />
    <TextView android:id="@+id/nexus_widget_progress_text" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textColor="#EDEFF4" android:textSize="11sp" android:maxLines="2" android:ellipsize="end" />
    <TextView android:id="@+id/nexus_widget_capture" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textColor="#EDEFF4" android:textSize="11sp" android:maxLines="2" android:ellipsize="end" />
    <TextView android:id="@+id/nexus_widget_accessory" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textColor="#EDEFF4" android:textSize="11sp" android:maxLines="2" android:ellipsize="end" />
    <TextView android:id="@+id/nexus_widget_streak" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textColor="#EDEFF4" android:textSize="11sp" android:maxLines="2" android:ellipsize="end" />
    <TextView android:id="@+id/nexus_widget_page" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textColor="#EDEFF4" android:textSize="11sp" android:maxLines="2" android:ellipsize="end" />
    <LinearLayout android:id="@+id/nexus_widget_task_3" style="@style/NexusWidgetTaskRow">
      <TextView android:id="@+id/nexus_widget_check_3" style="@style/NexusWidgetCheck"/>
      <TextView android:id="@+id/nexus_widget_task_title_3" style="@style/NexusWidgetTaskTitle"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/nexus_widget_task_4" style="@style/NexusWidgetTaskRow">
      <TextView android:id="@+id/nexus_widget_check_4" style="@style/NexusWidgetCheck"/>
      <TextView android:id="@+id/nexus_widget_task_title_4" style="@style/NexusWidgetTaskTitle"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/nexus_widget_task_5" style="@style/NexusWidgetTaskRow">
      <TextView android:id="@+id/nexus_widget_check_5" style="@style/NexusWidgetCheck"/>
      <TextView android:id="@+id/nexus_widget_task_title_5" style="@style/NexusWidgetTaskTitle"/>
    </LinearLayout>
  </LinearLayout>
</FrameLayout>
