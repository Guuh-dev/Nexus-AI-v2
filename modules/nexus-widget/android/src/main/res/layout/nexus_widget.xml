<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/nexus_widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:minWidth="250dp" android:minHeight="250dp" android:padding="12dp" android:background="@drawable/nexus_widget_background">
  <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_vertical">
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:minHeight="40dp">
          <FrameLayout android:id="@+id/nexus_widget_mascot_stage" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center">
      <ImageView android:id="@+id/nexus_widget_scene" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:alpha="0.85" android:visibility="gone" android:importantForAccessibility="no"/>
        <ImageView android:id="@+id/nexus_widget_mascot" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_gravity="center" android:adjustViewBounds="true" android:scaleType="fitCenter" android:src="@drawable/ic_nexus_mascot" android:contentDescription="@string/nexus_widget_mascot_description"/>
      </FrameLayout>
    </FrameLayout>
    <TextView android:id="@+id/nexus_widget_brand" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Seu dia, com direção." android:textColor="#F5F2EB" android:textSize="9sp" android:maxLines="2" android:ellipsize="end"/>
    <TextView android:id="@+id/nexus_widget_mission" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Entregar o primeiro ciclo" android:textColor="#F5F2EB" android:textSize="14sp" android:maxLines="2" android:ellipsize="end" android:textStyle="bold" android:layout_marginTop="4dp"/>
    <LinearLayout android:id="@+id/nexus_widget_task_1" style="@style/NexusWidgetTaskRow">
      <TextView android:id="@+id/nexus_widget_check_1" style="@style/NexusWidgetCheck"/>
      <TextView android:id="@+id/nexus_widget_task_title_1" style="@style/NexusWidgetTaskTitle"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/nexus_widget_task_2" style="@style/NexusWidgetTaskRow">
      <TextView android:id="@+id/nexus_widget_check_2" style="@style/NexusWidgetCheck"/>
      <TextView android:id="@+id/nexus_widget_task_title_2" style="@style/NexusWidgetTaskTitle"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/nexus_widget_task_3" style="@style/NexusWidgetTaskRow">
      <TextView android:id="@+id/nexus_widget_check_3" style="@style/NexusWidgetCheck"/>
      <TextView android:id="@+id/nexus_widget_task_title_3" style="@style/NexusWidgetTaskTitle"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/nexus_widget_task_4" style="@style/NexusWidgetTaskRow">
      <TextView android:id="@+id/nexus_widget_check_4" style="@style/NexusWidgetCheck"/>
      <TextView android:id="@+id/nexus_widget_task_title_4" style="@style/NexusWidgetTaskTitle"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
      <TextView android:id="@+id/nexus_widget_progress_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="#F5F2EB" android:textSize="9sp" android:maxLines="2" android:ellipsize="end" android:layout_marginEnd="8dp"/>
      <ProgressBar android:id="@+id/nexus_widget_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="0dp" android:layout_height="5dp" android:layout_weight="1" android:progressTint="#AC78F4" android:progressBackgroundTint="#272334"/>
    </LinearLayout>
    <TextView android:id="@+id/nexus_widget_metrics" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textColor="#F5F2EB" android:textSize="9sp" android:maxLines="2" android:ellipsize="end" android:layout_marginTop="6dp"/>
    <TextView android:id="@+id/nexus_widget_capture" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Abrir foco" android:textColor="#F5F2EB" android:textSize="10sp" android:maxLines="2" android:ellipsize="end" android:gravity="center" android:layout_marginTop="6dp" android:padding="5dp" android:background="@drawable/nexus_widget_background"/>
  </LinearLayout>
  <LinearLayout android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" android:orientation="vertical">
    <TextView android:id="@+id/nexus_widget_feature_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textColor="#F5F2EB" android:textSize="11sp" android:maxLines="2" android:ellipsize="end"/>
    <TextView android:id="@+id/nexus_widget_feature_body" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textColor="#F5F2EB" android:textSize="11sp" android:maxLines="2" android:ellipsize="end"/>
    <TextView android:id="@+id/nexus_widget_accessory" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textColor="#F5F2EB" android:textSize="11sp" android:maxLines="2" android:ellipsize="end"/>
    <TextView android:id="@+id/nexus_widget_streak" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textColor="#F5F2EB" android:textSize="11sp" android:maxLines="2" android:ellipsize="end"/>
    <TextView android:id="@+id/nexus_widget_page" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textColor="#F5F2EB" android:textSize="11sp" android:maxLines="2" android:ellipsize="end"/>
    <LinearLayout android:id="@+id/nexus_widget_task_5" style="@style/NexusWidgetTaskRow">
      <TextView android:id="@+id/nexus_widget_check_5" style="@style/NexusWidgetCheck"/>
      <TextView android:id="@+id/nexus_widget_task_title_5" style="@style/NexusWidgetTaskTitle"/>
    </LinearLayout>
  </LinearLayout>
</FrameLayout>
