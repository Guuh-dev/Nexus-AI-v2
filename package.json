{
  "name": "nexus-ai",
  "version": "3.0.0",
  "private": true,
  "description": "Nexus AI — Personal Mission OS",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "web": "expo start --web",
    "export:web": "expo export --platform web --max-workers 2",
    "serve:web": "expo serve",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "doctor": "expo-doctor",
    "security:secrets": "node scripts/scan-secrets.mjs",
    "release:check": "node scripts/release-check.mjs",
    "verify": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run security:secrets",
    "native:check": "node scripts/detect-native-changes.mjs"
  },
  "dependencies": {
    "@expo/dom-webview": "~57.0.1",
    "@expo/metro-runtime": "~57.0.16",
    "@openrouter/sdk": "^0.13.39",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.26",
    "expo-asset": "~57.0.18",
    "expo-audio": "~57.0.5",
    "expo-constants": "~57.0.20",
    "expo-crypto": "~57.0.3",
    "expo-device": "~57.0.2",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-haptics": "~57.0.3",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.11",
    "expo-navigation-bar": "~57.0.3",
    "expo-notifications": "~57.0.21",
    "expo-router": "~57.0.24",
    "expo-sharing": "~57.0.22",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.24",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@react-native/metro-config": "0.86.3",
    "@testing-library/react-native": "^14.0.1",
    "@types/node": "^26.1.1",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.4",
    "eslint-config-expo": "~57.0.2",
    "eslint-import-resolver-typescript": "^4.4.5",
    "expo-doctor": "1.20.0",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.13 <23"
  },
  "expo": {
    "autolinking": {
      "nativeModulesDir": "./modules"
    }
  },
  "overrides": {
    "uuid": "11.1.1"
  },
  "packageManager": "pnpm@10.0.0",
  "pnpm": {
    "overrides": {
      "uuid": "11.1.1",
      "browserslist@4": "4.29.3",
      "js-yaml@4": "4.3.2",
      "postcss@8": "8.5.28",
      "@xmldom/xmldom@<0.9": "0.8.15",
      "@xmldom/xmldom@>=0.9 <0.10": "0.9.12",
      "brace-expansion@1": "1.1.21",
      "brace-expansion@5": "5.0.12",
      "nanoid@3": "3.3.19",
      "baseline-browser-mapping@2": "2.11.27",
      "query-string@7.1.3>decode-uri-component": "0.5.0"
    },
    "patchedDependencies": {
      "query-string@7.1.3": "patches/query-string@7.1.3.patch",
      "node-forge@1.4.0": "patches/node-forge@1.4.0.patch"
    }
  }
}
